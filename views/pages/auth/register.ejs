<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <canvas id="cyber-canvas"></canvas>
  <div class="cyber-grid-overlay"></div>

  <%- include('../../partials/header') %>
  <%- include('../../partials/flash') %>

  <main class="main-content">
    <section class="section" style="padding-top: 5rem; min-height: 85vh; display: flex; align-items: center;">
      <div class="container" style="max-width: 560px;">
        <div class="cyber-card" style="padding: 3rem 2.5rem; background: rgba(8, 14, 35, 0.9);">
          <div style="text-align: center; margin-bottom: 2rem;">
            <div class="brand-icon" style="margin: 0 auto 1rem auto; width: 44px; height: 44px; font-size: 1.4rem;">⚡</div>
            <h2 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Provision Bitwise Identity</h2>
            <p style="font-size: 0.9rem; color: var(--text-secondary);">Join the next-generation AI campus network</p>
          </div>

          <form action="/auth/register" method="POST">
            <div class="form-group">
              <label class="form-label" for="name">Full Name *</label>
              <input type="text" id="name" name="name" class="form-input" required placeholder="Priya Patel">
            </div>

            <div class="form-group">
              <label class="form-label" for="email">Email Signature *</label>
              <input type="email" id="email" name="email" class="form-input" required placeholder="priya@example.com">
            </div>

            <div class="form-group">
              <label class="form-label" for="track">Primary Track of Interest</label>
              <select id="track" name="track" class="form-select">
                <option value="btech-ai-cs" <%= track === 'btech-ai-cs' ? 'selected' : '' %>>B.Tech in Artificial Intelligence & CS</option>
                <option value="btech-autonomous-systems" <%= track === 'btech-autonomous-systems' ? 'selected' : '' %>>B.Tech in Autonomous Systems & Robotics</option>
                <option value="founder-fellowship" <%= track === 'founder-fellowship' ? 'selected' : '' %>>Founder Fellowship & Accelerator</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="githubUsername">GitHub Handle (Optional)</label>
              <input type="text" id="githubUsername" name="githubUsername" class="form-input" placeholder="priyapatel-tech">
            </div>

            <div class="form-grid-2">
              <div class="form-group">
                <label class="form-label" for="password">Encryption Passcode *</label>
                <input type="password" id="password" name="password" class="form-input" required minlength="6" placeholder="••••••••">
              </div>

              <div class="form-group">
                <label class="form-label" for="confirmPassword">Confirm Passcode *</label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" required minlength="6" placeholder="••••••••">
              </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 1rem;">
              <span>⚡ Register & Unlock Admissions</span>
            </button>
          </form>

          <div style="text-align: center; margin-top: 1.5rem; font-size: 0.88rem; color: var(--text-muted);">
            Already have an active identity? <a href="/auth/login" style="color: var(--neon-cyan); font-weight: 600;">Sign In</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('../../partials/ai-assistant') %>
  <%- include('../../partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
