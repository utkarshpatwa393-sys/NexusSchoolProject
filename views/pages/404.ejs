<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <canvas id="cyber-canvas"></canvas>
  <div class="cyber-grid-overlay"></div>

  <%- include('../partials/header') %>
  <%- include('../partials/flash') %>

  <main class="main-content">
    <section class="section" style="min-height: 75vh; display: flex; align-items: center; text-align: center;">
      <div class="container" style="max-width: 600px;">
        <div class="cyber-card" style="padding: 4rem 2rem;">
          <div style="font-family: var(--font-mono); font-size: 5rem; font-weight: 900; color: var(--neon-cyan); text-shadow: 0 0 30px var(--neon-cyan); line-height: 1;">
            404
          </div>
          <h2 style="margin: 1.5rem 0 1rem 0;">Neural Node Disconnected</h2>
          <p style="margin-bottom: 2rem; color: var(--text-secondary);">
            The routing pathway you attempted to traverse does not exist in the Nexus Core network matrix.
          </p>
          <div style="display: flex; justify-content: center; gap: 1rem;">
            <a href="/" class="btn btn-primary">⚡ Return to Home Grid</a>
            <a href="/curriculum" class="btn btn-outline">Explore Syllabus</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/ai-assistant') %>
  <%- include('../partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
