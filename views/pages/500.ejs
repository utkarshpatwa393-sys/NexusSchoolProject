<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <canvas id="cyber-canvas"></canvas>
  <div class="cyber-grid-overlay"></div>

  <%- include('../partials/header') %>
  <%- include('../partials/flash') %>

  <main class="main-content">
    <section class="section" style="min-height: 75vh; display: flex; align-items: center; text-align: center;">
      <div class="container" style="max-width: 650px;">
        <div class="cyber-card" style="padding: 4rem 2rem; border-color: var(--neon-rose);">
          <div style="font-family: var(--font-mono); font-size: 5rem; font-weight: 900; color: var(--neon-rose); text-shadow: 0 0 30px var(--neon-rose); line-height: 1;">
            500
          </div>
          <h2 style="margin: 1.5rem 0 1rem 0;">Subsystem Malfunction</h2>
          <p style="margin-bottom: 2rem; color: var(--text-secondary);">
            An unexpected error occurred within the neural gateway. Our automated self-healing orchestration is investigating.
          </p>
          <% if (error) { %>
            <pre style="text-align: left; background: #000; padding: 1rem; border-radius: 6px; font-family: var(--font-mono); font-size: 0.8rem; color: #ff0055; overflow-x: auto; margin-bottom: 2rem;"><%= error.stack %></pre>
          <% } %>
          <div style="display: flex; justify-content: center; gap: 1rem;">
            <a href="/" class="btn btn-primary">⚡ Return to Home Grid</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/ai-assistant') %>
  <%- include('../partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
