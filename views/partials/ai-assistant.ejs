<!-- Floating AI Bot Trigger -->
<div class="ai-bot-trigger" id="ai-bot-trigger" title="Bitwise AI Navigator">
  <span style="font-size: 1.6rem;">🤖</span>
</div>

<!-- Floating AI Bot Chat Drawer -->
<div class="ai-bot-drawer" id="ai-bot-drawer">
  <div class="ai-bot-header">
    <div style="display: flex; align-items: center; gap: 0.6rem;">
      <span class="status-dot"></span>
      <div>
        <div style="font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; color: #fff;">Bitwise AI Navigator</div>
        <div style="font-size: 0.72rem; color: var(--neon-cyan); font-family: var(--font-mono);">Autonomous Admissions Assistant</div>
      </div>
    </div>
    <button class="flash-close-btn" id="ai-bot-close">✕</button>
  </div>

  <div class="ai-chips-container">
    <div class="ai-prompt-chip" data-prompt="How does the Income Share Agreement (ISA) work?">💡 Explain ISA</div>
    <div class="ai-prompt-chip" data-prompt="What GPU compute hardware do students receive?">⚡ GPU Specs</div>
    <div class="ai-prompt-chip" data-prompt="Who are the faculty and industry mentors?">👥 Mentors</div>
    <div class="ai-prompt-chip" data-prompt="What is the admissions selection process?">🚀 Admissions</div>
  </div>

  <div class="ai-bot-chat-body" id="ai-bot-messages">
    <div class="chat-bubble chat-bubble-bot">
      Welcome to Bitwise School of Technology! I'm your Neural Navigator. Ask me anything about our AI-first B.Tech curriculum, NVIDIA H100 compute cluster, or the 2026 admissions cycle.
    </div>
  </div>

  <div class="ai-bot-input-area">
    <input type="text" class="form-input" id="ai-bot-input" placeholder="Query Bitwise neural knowledge..." style="padding: 0.6rem 0.8rem; font-size: 0.85rem;">
    <button class="btn btn-sm btn-primary" id="ai-bot-send">Ask</button>
  </div>
</div>
